pipeline {
    agent any

    stages {
        stage('pull') {
            steps {
                git branch: 'main', url: 'https://github.com/AnjaliDapke10/Fertilizer-Shop-Management-System.git'
                git branch: 'main', url: 'https://github.com/shubham-gayke/shubham-gayke.git'
                echo "pull successfull"
            }
        }
        stage('Build') {
            steps {
                echo "Building successfull "
            }
        }
        stage('Test') {
            steps {
                echo "Testing sussessfull"
            }
        }
        stage('Deploy') {
            steps {
                echo "Deploying successfull"
            }
        }
    }
}
